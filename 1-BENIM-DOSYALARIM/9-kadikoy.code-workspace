{
  "folders": [
    {
      "name": "ScrumAssistantFrontend",
      "path": "ScrumAssistantFrontend"
    },
    {
      "name": "ScrumAssistantBackend",
      "path": "ScrumAssistantBackend"
    },
    {
      "name": "Docs",
      "path": "docs"
    },
    {
      "name": "KADIKOY-AGENTS",
      "path": "KADIKOY-AGENTS"
    }
  ],
  "settings": {
    "chat.useAgentsMdFile": true,
    "chat.useNestedAgentsMdFiles": true,
    "chat.includeApplyingInstructions": true,
    "chat.includeReferencedInstructions": true,
    "files.exclude": {
      "**/node_modules": true,
      "**/target": true,
      "**/.angular": true,
      "**/dist": true
    }
  },
  "extensions": {
    "recommendations": [
      "github.copilot",
      "github.copilot-chat",
      "angular.ng-template",
      "vscjava.vscode-java-pack",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml"
    ]
  }
}
